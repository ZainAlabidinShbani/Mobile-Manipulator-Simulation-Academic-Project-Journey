  <version>0.1.0</version>
  <description>Arm kinematics, trajectory generation, and simulated control for the autonomous mobile manipulator.</description>
  <maintainer email="essa@todo.todo">essa</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>mobile_manipulator_msgs</exec_depend>
