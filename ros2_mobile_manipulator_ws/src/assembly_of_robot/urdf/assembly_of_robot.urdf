<?xml version="1.0" encoding="utf-8"?>
<!--
  Mobile Manipulator URDF — ROS 2 Humble
  =======================================
  Originally exported from SolidWorks 2022 via sw_urdf_exporter (ROS 1).
  Converted to ROS 2 by the project team:
    - All actuated joints set to correct types (continuous / revolute)
    - Physically realistic inertia values replacing SolidWorks micro-kg output
    - Gazebo ROS 2 plugins added (diff_drive, camera)
    - Sensor joints kept fixed (camera, ultrasonic)
    - Mesh paths preserved: package://assembly_of_robot/meshes/
-->
<robot name="assembly_of_robot">

  <!-- ================================================================
       MATERIALS
       ================================================================ -->
  <material name="mat_chassis">
    <color rgba="0.667 0.698 0.769 1.0"/>
  </material>
  <material name="mat_wheel">
    <color rgba="0.792 0.820 0.933 1.0"/>
  </material>
  <material name="mat_arm">
    <color rgba="0.918 0.918 0.918 1.0"/>
  </material>
  <material name="mat_sensor">
    <color rgba="0.2 0.2 0.8 1.0"/>
  </material>

  <!-- ================================================================
       BASE LINK  (robot chassis)
       mass: 2.0 kg  |  approx box 0.28 x 0.20 x 0.08 m
       ================================================================ -->
  <link name="base_link">
    <inertial>
      <!-- Center of mass offset from SolidWorks export -->
      <origin xyz="-0.003706 -0.001239 -0.032645" rpy="0 0 0"/>
      <mass value="2.0"/>
      <!-- Ixx = m/12*(ly^2+lz^2), Iyy = m/12*(lx^2+lz^2), Izz = m/12*(lx^2+ly^2) -->
      <inertia ixx="0.007867" ixy="0.0" ixz="0.0"
               iyy="0.013733" iyz="0.0"
               izz="0.019067"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/base_link.STL"/>
      </geometry>
      <material name="mat_chassis"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- Gazebo chassis surface properties -->
  <gazebo reference="base_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ================================================================
       FRONT-LEFT WHEEL  (driven)
       mass: 0.3 kg  |  approx cylinder r=0.033 m, l=0.025 m
       ================================================================ -->
  <link name="wheel_fl_link">
    <inertial>
      <origin xyz="-0.000106 -0.001747 0.010127" rpy="0 0 0"/>
      <mass value="0.3"/>
      <!-- Cylinder: Ixx=Iyy=m/12*(3r^2+l^2), Izz=m/2*r^2 -->
      <inertia ixx="8.44e-05" ixy="0.0" ixz="0.0"
               iyy="8.44e-05" iyz="0.0"
               izz="1.634e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/wheel_fl_link.STL"/>
      </geometry>
      <material name="mat_wheel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/wheel_fl_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- wheel_fl: continuous — spins around Z axis in joint frame -->
  <joint name="wheel_fl_joint" type="continuous">
    <origin xyz="-0.064799 -0.06515 -0.020884" rpy="1.5708 -0.060409 0.050643"/>
    <parent link="base_link"/>
    <child  link="wheel_fl_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <gazebo reference="wheel_fl_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ================================================================
       FRONT-RIGHT WHEEL  (driven)
       ================================================================ -->
  <link name="wheel_fr_link">
    <inertial>
      <origin xyz="-0.000106 0.001747 0.010127" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="8.44e-05" ixy="0.0" ixz="0.0"
               iyy="8.44e-05" iyz="0.0"
               izz="1.634e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/wheel_fr_link.STL"/>
      </geometry>
      <material name="mat_wheel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/wheel_fr_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_fr_joint" type="continuous">
    <origin xyz="-0.070948 0.056167 -0.020884" rpy="-1.5708 -0.060409 0.050643"/>
    <parent link="base_link"/>
    <child  link="wheel_fr_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <gazebo reference="wheel_fr_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ================================================================
       BACK-LEFT WHEEL  (passive caster — low friction)
       ================================================================ -->
  <link name="wheel_bl_link">
    <inertial>
      <origin xyz="-0.000106 -0.001747 0.010127" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="8.44e-05" ixy="0.0" ixz="0.0"
               iyy="8.44e-05" iyz="0.0"
               izz="1.634e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/wheel_bl_link.STL"/>
      </geometry>
      <material name="mat_wheel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/wheel_bl_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- Rear wheel continuous but passive (no drive command, low friction) -->
  <joint name="wheel_bl_joint" type="continuous">
    <origin xyz="0.063537 -0.058645 -0.020884" rpy="1.5708 -0.060409 0.050643"/>
    <parent link="base_link"/>
    <child  link="wheel_bl_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.001" friction="0.001"/>
  </joint>

  <!-- Low friction so rear wheels follow freely (caster behaviour) -->
  <gazebo reference="wheel_bl_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ================================================================
       BACK-RIGHT WHEEL  (passive caster)
       ================================================================ -->
  <link name="wheel_br_link">
    <inertial>
      <origin xyz="-0.000106 0.001747 0.010127" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="8.44e-05" ixy="0.0" ixz="0.0"
               iyy="8.44e-05" iyz="0.0"
               izz="1.634e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/wheel_br_link.STL"/>
      </geometry>
      <material name="mat_wheel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/wheel_br_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_br_joint" type="continuous">
    <origin xyz="0.057387 0.062672 -0.020884" rpy="-1.5708 -0.060409 0.050643"/>
    <parent link="base_link"/>
    <child  link="wheel_br_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.001" friction="0.001"/>
  </joint>

  <gazebo reference="wheel_br_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ================================================================
       ARM LINK 1  (base yaw — rotates around vertical Z axis)
       mass: 0.5 kg
       ================================================================ -->
  <link name="arm_link_1">
    <inertial>
      <origin xyz="-0.124123 0.006746 -0.030826" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="1.042e-03" ixy="0.0" ixz="0.0"
               iyy="1.042e-03" iyz="0.0"
               izz="5.208e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/arm_link_1.STL"/>
      </geometry>
      <material name="mat_arm"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/arm_link_1.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- arm_joint_1: base yaw ±180° -->
  <joint name="arm_joint_1" type="revolute">
    <origin xyz="0.18587 0.0065057 0.10591" rpy="-3.0796 -0.66341 -0.035278"/>
    <parent link="base_link"/>
    <child  link="arm_link_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <gazebo reference="arm_link_1">
    <material>Gazebo/White</material>
  </gazebo>

  <!-- ================================================================
       ARM LINK 2  (shoulder pitch)
       mass: 0.3 kg
       ================================================================ -->
  <link name="arm_link_2">
    <inertial>
      <origin xyz="0.006486 -0.003568 0.014667" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="3.75e-04" ixy="0.0" ixz="0.0"
               iyy="3.75e-04" iyz="0.0"
               izz="1.875e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/arm_link_2.STL"/>
      </geometry>
      <material name="mat_arm"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/arm_link_2.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- arm_joint_2: shoulder pitch ±90° -->
  <joint name="arm_joint_2" type="revolute">
    <origin xyz="-0.097734 0.032099 -0.045897"
            rpy="1.570796 -0.605406 -0.079155"/>
    <parent link="arm_link_1"/>
    <child  link="arm_link_2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="8.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <gazebo reference="arm_link_2">
    <material>Gazebo/White</material>
  </gazebo>

  <!-- ================================================================
       ARM LINK 3  (elbow pitch)
       mass: 0.2 kg
       ================================================================ -->
  <link name="arm_link_3">
    <inertial>
      <origin xyz="0.001850 0.002144 0.014667" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="1.667e-04" ixy="0.0" ixz="0.0"
               iyy="1.667e-04" iyz="0.0"
               izz="1.0e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/arm_link_3.STL"/>
      </geometry>
      <material name="mat_arm"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/arm_link_3.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- arm_joint_3: elbow pitch ±90° -->
  <joint name="arm_joint_3" type="revolute">
    <origin xyz="0 0 0.05472" rpy="-3.14159 0 0"/>
    <parent link="arm_link_2"/>
    <child  link="arm_link_3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="6.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <gazebo reference="arm_link_3">
    <material>Gazebo/White</material>
  </gazebo>

  <!-- ================================================================
       GRIPPER LINK  (wrist / end-effector)
       mass: 0.15 kg
       ================================================================ -->
  <link name="gripper_link">
    <inertial>
      <origin xyz="0.113318 0.000813 0.068197" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="1.25e-04" ixy="0.0" ixz="0.0"
               iyy="6.75e-05" iyz="0.0"
               izz="1.59e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/gripper_link.STL"/>
      </geometry>
      <material name="mat_arm"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/gripper_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- gripper_joint: wrist rotation ±90° -->
  <joint name="gripper_joint" type="revolute">
    <origin xyz="-0.007116 -0.040604 0.027360"
            rpy="-1.570796 -0.065250 -0.060460"/>
    <parent link="arm_link_3"/>
    <child  link="gripper_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="4.0" velocity="1.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <gazebo reference="gripper_link">
    <material>Gazebo/White</material>
  </gazebo>

  <!-- ================================================================
       CAMERA LINK  (fixed sensor — RGB-D / monocular)
       mass: 0.05 kg
       ================================================================ -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.0e-05" ixy="0.0" ixz="0.0"
               iyy="1.0e-05" iyz="0.0"
               izz="1.0e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/camera_link.STL"/>
      </geometry>
      <material name="mat_sensor"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/camera_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- Camera joint kept fixed — no actuation needed -->
  <joint name="camera_joint" type="fixed">
    <origin xyz="-0.10746 -0.021291 0.093296" rpy="0.89986 -1.2952 -0.86787"/>
    <parent link="base_link"/>
    <child  link="camera_link"/>
  </joint>

  <!-- Gazebo camera plugin (ROS 2 compatible) -->
  <gazebo reference="camera_link">
    <sensor name="rgb_camera" type="camera">
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>image_raw:=/camera/image_raw</remapping>
          <remapping>camera_info:=/camera/camera_info</remapping>
        </ros>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ================================================================
       ULTRASONIC SENSORS  (all fixed — range sensors)
       mass: 0.01 kg each
       ================================================================ -->

  <!-- Front-left ultrasonic -->
  <link name="ultrasonic_front_left_link">
    <inertial>
      <origin xyz="-0.004105 0.003422 0.000788" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1.0e-06" ixy="0.0" ixz="0.0"
               iyy="1.0e-06" iyz="0.0"
               izz="1.0e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/ultrasonic_front_left_link.STL"/>
      </geometry>
      <material name="mat_sensor"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/ultrasonic_front_left_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="ultrasonic_front_left_joint" type="fixed">
    <origin xyz="-0.12324 -0.05497 -0.026486" rpy="1.5708 -0.10222 -0.94112"/>
    <parent link="base_link"/>
    <child  link="ultrasonic_front_left_link"/>
  </joint>

  <!-- Front-center ultrasonic -->
  <link name="ultrasonic_front_center_link">
    <inertial>
      <origin xyz="0.003241 -0.002616 0.004915" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1.0e-06" ixy="0.0" ixz="0.0"
               iyy="1.0e-06" iyz="0.0"
               izz="1.0e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/ultrasonic_front_center_link.STL"/>
      </geometry>
      <material name="mat_sensor"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/ultrasonic_front_center_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="ultrasonic_front_center_joint" type="fixed">
    <origin xyz="-0.13537 -0.0024024 -0.022602" rpy="1.5708 -0.46141 -1.449"/>
    <parent link="base_link"/>
    <child  link="ultrasonic_front_center_link"/>
  </joint>

  <!-- Front-right ultrasonic -->
  <link name="ultrasonic_front_right_link">
    <inertial>
      <origin xyz="-0.002619 0.009645 0.003869" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1.0e-06" ixy="0.0" ixz="0.0"
               iyy="1.0e-06" iyz="0.0"
               izz="1.0e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/ultrasonic_front_right_link.STL"/>
      </geometry>
      <material name="mat_sensor"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/ultrasonic_front_right_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="ultrasonic_front_right_joint" type="fixed">
    <origin xyz="-0.1231 0.038886 -0.013507" rpy="-1.5708 -0.26082 1.3425"/>
    <parent link="base_link"/>
    <child  link="ultrasonic_front_right_link"/>
  </joint>

  <!-- Side-left ultrasonic -->
  <link name="ultrasonic_side_left_link">
    <inertial>
      <origin xyz="-0.000560 -0.009979 0.003869" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1.0e-06" ixy="0.0" ixz="0.0"
               iyy="1.0e-06" iyz="0.0"
               izz="1.0e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/ultrasonic_side_left_link.STL"/>
      </geometry>
      <material name="mat_sensor"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/ultrasonic_side_left_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="ultrasonic_side_left_joint" type="fixed">
    <origin xyz="-0.0023558 -0.076267 -0.013507" rpy="1.5708 -0.060409 0.050643"/>
    <parent link="base_link"/>
    <child  link="ultrasonic_side_left_link"/>
  </joint>

  <!-- Side-right ultrasonic -->
  <link name="ultrasonic_side_right_link">
    <inertial>
      <origin xyz="-0.000647 0.009974 0.003869" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1.0e-06" ixy="0.0" ixz="0.0"
               iyy="1.0e-06" iyz="0.0"
               izz="1.0e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/ultrasonic_side_right_link.STL"/>
      </geometry>
      <material name="mat_sensor"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/ultrasonic_side_right_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="ultrasonic_side_right_joint" type="fixed">
    <origin xyz="-0.013339 0.073369 -0.013507"
            rpy="-1.570796 -0.060409 0.050643"/>
    <parent link="base_link"/>
    <child  link="ultrasonic_side_right_link"/>
  </joint>

  <!-- ================================================================
       GAZEBO DIFFERENTIAL DRIVE PLUGIN
       Controls front wheels via /cmd_vel, publishes odometry to /odom
       ================================================================ -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>

      <!-- Driven (front) wheels -->
      <left_joint>wheel_fl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint>

      <!-- Physical parameters — match URDF geometry -->
      <wheel_separation>0.121317</wheel_separation>
      <wheel_diameter>0.066</wheel_diameter>

      <!-- Plugin performance tuning -->
      <max_wheel_torque>5.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <update_rate>20.0</update_rate>
      <command_timeout>0.5</command_timeout>

      <!-- Odometry settings -->
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
    </plugin>
  </gazebo>

</robot>
