    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/arm_link_2.STL" />
      </geometry>
    </collision>
  </link>
  <!-- arm_joint_2: shoulder pitch, revolute about Y -->
  <joint name="arm_joint_2" type="revolute">
    <origin xyz="-0.0977 0.0321 -0.0459" rpy="1.5708 0 0" />
    <parent link="arm_link_1" />
    <child link="arm_link_2" />
    <axis xyz="0 1 0" />
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- ==================== ARM LINK 3 ==================== -->
  <link name="arm_link_3">
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.0005" ixy="0" ixz="0"
