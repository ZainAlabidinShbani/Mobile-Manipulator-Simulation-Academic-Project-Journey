      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/gripper_link.STL" />
      </geometry>
    </collision>
  </link>
  <!-- gripper_joint: wrist rotation, revolute about Z -->
  <joint name="gripper_joint" type="revolute">
    <origin xyz="-0.00711 -0.04060 0.02736" rpy="-1.5708 0 0" />
    <parent link="arm_link_3" />
    <child link="gripper_link" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="1.0" />
    <dynamics damping="0.05" friction="0.05" />
  </joint>

  <!-- ==================== CAMERA ==================== -->
  <link name="camera_link">
