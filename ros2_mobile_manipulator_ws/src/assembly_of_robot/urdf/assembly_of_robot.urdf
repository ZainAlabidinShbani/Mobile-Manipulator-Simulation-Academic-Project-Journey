        <mesh filename="package://assembly_of_robot/meshes/wheel_br_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="wheel_br_joint" type="continuous">
    <origin xyz="0.057387 0.062672 -0.020884" rpy="-1.5708 0 0" />
    <parent link="base_link" />
    <child link="wheel_br_link" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- ==================== ARM LINK 1 ==================== -->
  <link name="arm_link_1">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0"
               izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/arm_link_1.STL" />
      </geometry>
      <material name="white">
        <color rgba="0.918 0.918 0.918 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/arm_link_1.STL" />
      </geometry>
    </collision>
  </link>
  <!-- arm_joint_1: base rotation (yaw), revolute about Z -->
  <joint name="arm_joint_1" type="revolute">
    <origin xyz="0.18587 0.0065057 0.10591" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="arm_link_1" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- ==================== ARM LINK 2 ==================== -->
  <link name="arm_link_2">
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0"
               izz="0.0005" />
