<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed URDF: joint types corrected, inertia scaled, ready for RViz + Gazebo -->
<robot name="assembly_of_robot">

  <!-- ==================== BASE LINK ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0" />
      <mass value="5.0" />
      <inertia ixx="0.05" ixy="0" ixz="0"
               iyy="0.06" iyz="0"
               izz="0.08" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/base_link.STL" />
      </geometry>
      <material name="silver">
        <color rgba="0.666 0.698 0.769 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== WHEEL FL ==================== -->
  <link name="wheel_fl_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.0002" ixy="0" ixz="0"
               iyy="0.0002" iyz="0"
               izz="0.0003" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/wheel_fl_link.STL" />
      </geometry>
      <material name="dark_silver">
        <color rgba="0.792 0.820 0.933 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/wheel_fl_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="wheel_fl_joint" type="continuous">
    <origin xyz="-0.064799 -0.06515 -0.020884" rpy="1.5708 0 0" />
    <parent link="base_link" />
    <child link="wheel_fl_link" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- ==================== WHEEL FR ==================== -->
  <link name="wheel_fr_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.0002" ixy="0" ixz="0"
               iyy="0.0002" iyz="0"
               izz="0.0003" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/wheel_fr_link.STL" />
      </geometry>
      <material name="dark_silver" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://assembly_of_robot/meshes/wheel_fr_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="wheel_fr_joint" type="continuous">
    <origin xyz="-0.070948 0.056167 -0.020884" rpy="-1.5708 0 0" />
    <parent link="base_link" />
    <child link="wheel_fr_link" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- ==================== WHEEL BL ==================== -->
  <link name="wheel_bl_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.3" />
