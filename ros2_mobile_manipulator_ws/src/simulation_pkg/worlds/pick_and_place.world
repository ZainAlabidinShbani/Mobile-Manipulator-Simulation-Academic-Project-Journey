<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="pick_and_place_world">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <model name="pick_table">
      <static>true</static>
      <link name="link">
        <pose>1.4 0 0.375 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.9 0.7 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.9 0.7 0.75</size></box></geometry><material><ambient>0.45 0.3 0.2 1</ambient><diffuse>0.45 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="drop_zone">
      <static>true</static>
      <link name="link">
        <pose>-1.2 -0.9 0.1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.3 0.3 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.3 0.3 0.2</size></box></geometry><material><ambient>0.2 0.7 0.2 1</ambient><diffuse>0.2 0.7 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="target_cube">
      <static>true</static>
      <link name="link">
        <pose>1.3 0.1 0.82 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
