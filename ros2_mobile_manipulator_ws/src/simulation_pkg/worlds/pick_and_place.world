<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="warehouse_pick_and_place">

    <!-- ═══════════════════════════════════════════════════════
         SCENE SETTINGS
    ═══════════════════════════════════════════════════════ -->
    <scene>
      <ambient>0.3 0.3 0.3 1</ambient>
      <background>0.15 0.15 0.2 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- ═══════════════════════════════════════════════════════
         LIGHTING  —  main overhead + two side fills
    ═══════════════════════════════════════════════════════ -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.3 -0.9</direction>
    </light>

    <light name="overhead_1" type="point">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><constant>0.4</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="overhead_2" type="point">
      <pose>4 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><constant>0.4</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="overhead_3" type="point">
      <pose>-4 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><constant>0.4</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ═══════════════════════════════════════════════════════
         GROUND PLANE  —  concrete texture colour
    ═══════════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.38 0.38 0.38 1</ambient>
            <diffuse>0.42 0.42 0.42 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════
         WAREHOUSE WALLS  (10 m × 10 m room, h=3 m)
    ═══════════════════════════════════════════════════════ -->
    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <pose>0 5 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>10 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.2 3</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
    </model>
    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <pose>0 -5 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>10 0.2 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.2 3</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
    </model>
    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <pose>5 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 10 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 10 3</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
    </model>
    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <pose>-5 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 10 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 10 3</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════
         STORAGE SHELVES  —  left side of warehouse
    ═══════════════════════════════════════════════════════ -->
    <!-- Shelf frame left -->
    <model name="shelf_left">
      <static>true</static>
      <link name="link">
        <pose>-3.5 2 0.9 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.4 2.0 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 2.0 1.8</size></box></geometry>
          <material><ambient>0.4 0.35 0.25 1</ambient><diffuse>0.4 0.35 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Shelf frame right -->
    <model name="shelf_right">
      <static>true</static>
      <link name="link">
        <pose>-3.5 -2 0.9 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.4 2.0 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 2.0 1.8</size></box></geometry>
          <material><ambient>0.4 0.35 0.25 1</ambient><diffuse>0.4 0.35 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════
         PICK STATION  —  industrial work table
    ═══════════════════════════════════════════════════════ -->
    <!-- Table top -->
    <model name="pick_table_top">
      <static>true</static>
      <link name="link">
        <pose>2.0 0 0.77 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.2 0.8 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.8 0.05</size></box></geometry>
          <material><ambient>0.85 0.82 0.78 1</ambient><diffuse>0.85 0.82 0.78 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      </link>
    </model>
    <!-- Table leg FL -->
    <model name="leg_fl">
      <static>true</static>
      <link name="link">
        <pose>1.55 0.33 0.375 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.75</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Table leg FR -->
    <model name="leg_fr">
      <static>true</static>
      <link name="link">
        <pose>2.45 0.33 0.375 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.75</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Table leg BL -->
    <model name="leg_bl">
      <static>true</static>
      <link name="link">
        <pose>1.55 -0.33 0.375 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.75</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Table leg BR -->
    <model name="leg_br">
      <static>true</static>
      <link name="link">
        <pose>2.45 -0.33 0.375 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.75</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════
         TARGET OBJECTS on pick table  (z = 0.80)
    ═══════════════════════════════════════════════════════ -->
    <!-- Bottle  —  blue cylinder  (YOLO: bottle) -->
    <model name="target_bottle">
      <static>true</static>
      <link name="link">
        <pose>1.85 0.15 0.90 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry>
          <material><ambient>0.1 0.25 0.85 1</ambient><diffuse>0.1 0.25 0.85 1</diffuse><specular>0.4 0.4 0.6 1</specular></material></visual>
      </link>
    </model>
    <!-- Cup  —  orange cylinder  (YOLO: cup) -->
    <model name="target_cup">
      <static>true</static>
      <link name="link">
        <pose>2.1 -0.1 0.83 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.042</radius><length>0.11</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.042</radius><length>0.11</length></cylinder></geometry>
          <material><ambient>0.9 0.45 0.05 1</ambient><diffuse>0.9 0.45 0.05 1</diffuse><specular>0.3 0.2 0.1 1</specular></material></visual>
      </link>
    </model>
    <!-- Cube  —  red box  (custom class: cube) -->
    <model name="target_cube">
      <static>true</static>
      <link name="link">
        <pose>2.25 0.2 0.825 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.06 0.06 0.06</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════
         DROP / DELIVERY STATION
    ═══════════════════════════════════════════════════════ -->
    <!-- Platform base -->
    <model name="drop_platform">
      <static>true</static>
      <link name="link">
        <pose>-2.0 -2.5 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.6 0.6 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.3</size></box></geometry>
          <material><ambient>0.15 0.6 0.15 1</ambient><diffuse>0.15 0.6 0.15 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Border marker ring (thin box on top) -->
    <model name="drop_border">
      <static>true</static>
      <link name="link">
        <pose>-2.0 -2.5 0.308 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.62 0.62 0.016</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.62 0.62 0.016</size></box></geometry>
          <material><ambient>0.9 0.9 0.1 1</ambient><diffuse>0.9 0.9 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════
         OBSTACLES  —  to challenge navigation
    ═══════════════════════════════════════════════════════ -->
    <!-- Pillar centre -->
    <model name="pillar_centre">
      <static>true</static>
      <link name="link">
        <pose>0 0 1.0 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.12</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.12</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Box obstacle 1 -->
    <model name="obstacle_box_1">
      <static>true</static>
      <link name="link">
        <pose>0.5 2.5 0.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.4 0.4 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.6</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Box obstacle 2 -->
    <model name="obstacle_box_2">
      <static>true</static>
      <link name="link">
        <pose>-1.0 1.5 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.35 0.35 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 0.35 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════
         ROBOT START ZONE MARKER  —  yellow floor stripe
    ═══════════════════════════════════════════════════════ -->
    <model name="start_zone">
      <static>true</static>
      <link name="link">
        <pose>0 0 0.002 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.6 0.6 0.004</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.004</size></box></geometry>
          <material><ambient>0.95 0.85 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
