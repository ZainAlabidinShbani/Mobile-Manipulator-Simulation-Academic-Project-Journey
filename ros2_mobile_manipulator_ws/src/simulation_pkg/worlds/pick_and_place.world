<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="pick_and_place_world">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- ═══════════════════════════════════════════════════════
         PICK TABLE  —  brown table at x=1.4
    ═══════════════════════════════════════════════════════ -->
    <model name="pick_table">
      <static>true</static>
      <link name="link">
        <pose>1.4 0 0.375 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.9 0.7 0.75</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.7 0.75</size></box></geometry>
          <material><ambient>0.45 0.3 0.2 1</ambient><diffuse>0.45 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════
         DROP ZONE  —  green platform at x=-1.2
    ═══════════════════════════════════════════════════════ -->
    <model name="drop_zone">
      <static>true</static>
      <link name="link">
        <pose>-1.2 -0.9 0.1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.3 0.3 0.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.2</size></box></geometry>
          <material><ambient>0.2 0.7 0.2 1</ambient><diffuse>0.2 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════
         TARGET OBJECTS on the pick table  (z=0.75 table top)
         Sized and coloured to be detectable by YOLOv8n
    ═══════════════════════════════════════════════════════ -->

    <!-- Bottle  — tall blue cylinder  (COCO: bottle) -->
    <model name="target_bottle">
      <static>true</static>
      <link name="link">
        <pose>1.25 -0.15 0.85 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.035</radius><length>0.20</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.035</radius><length>0.20</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.3 0.9 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cup  — short orange cylinder  (COCO: cup) -->
    <model name="target_cup">
      <static>true</static>
      <link name="link">
        <pose>1.45 0.15 0.80 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.04</radius><length>0.10</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.04</radius><length>0.10</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.4 0.1 1</ambient>
            <diffuse>0.9 0.4 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Small box  — red cube, original target kept -->
    <model name="target_cube">
      <static>true</static>
      <link name="link">
        <pose>1.3 0.1 0.82 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
