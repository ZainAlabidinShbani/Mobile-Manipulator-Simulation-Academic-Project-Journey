<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_manipulator">
  <xacro:property name="pi" value="3.141592653589793"/>
  <xacro:property name="base_length" value="0.46"/>
  <xacro:property name="base_width" value="0.38"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="arm_link1" value="0.28"/>
  <xacro:property name="arm_link2" value="0.24"/>
  <xacro:property name="arm_link3" value="0.14"/>

  <link name="base_link">
    <inertial><origin xyz="0 0 0"/><mass value="18.0"/><inertia ixx="0.6" ixy="0.0" ixz="0.0" iyy="0.6" iyz="0.0" izz="0.8"/></inertial>
    <visual><origin xyz="0 0 ${base_height/2.0}"/><geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry><material name="Gray"><color rgba="0.6 0.6 0.65 1.0"/></material></visual>
    <collision><origin xyz="0 0 ${base_height/2.0}"/><geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry></collision>
  </link>
  <link name="base_laser"/>
  <joint name="base_laser_joint" type="fixed"><parent link="base_link"/><child link="base_laser"/><origin xyz="0.18 0 0.22" rpy="0 0 0"/></joint>
  <link name="arm_base_link">
    <visual><origin xyz="0 0 0.05"/><geometry><cylinder length="0.1" radius="0.08"/></geometry><material name="Blue"><color rgba="0.2 0.4 0.8 1.0"/></material></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><cylinder length="0.1" radius="0.08"/></geometry></collision>
  </link>
  <joint name="arm_base_joint" type="fixed"><parent link="base_link"/><child link="arm_base_link"/><origin xyz="0 0 0.18" rpy="0 0 0"/></joint>
  <link name="camera_link">
    <visual><geometry><box size="0.05 0.03 0.03"/></geometry><material name="Orange"><color rgba="0.9 0.5 0.2 1.0"/></material></visual>
  </link>
  <joint name="camera_joint" type="fixed"><parent link="arm_base_link"/><child link="camera_link"/><origin xyz="0.15 0 0.28" rpy="0 0 0"/></joint>
  <link name="arm_link_1"><visual><geometry><cylinder length="${arm_link1}" radius="0.04"/></geometry><material name="Red"><color rgba="0.8 0.2 0.2 1.0"/></material></visual></link>
  <joint name="arm_joint_1" type="revolute"><parent link="arm_base_link"/><child link="arm_link_1"/><origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-${pi}" upper="${pi}" effort="30" velocity="1.5"/></joint>
  <link name="arm_link_2"><visual><origin xyz="${arm_link2/2.0} 0 0"/><geometry><box size="${arm_link2} 0.05 0.05"/></geometry><material name="Green"><color rgba="0.2 0.8 0.3 1.0"/></material></visual></link>
  <joint name="arm_joint_2" type="revolute"><parent link="arm_link_1"/><child link="arm_link_2"/><origin xyz="0 0 ${arm_link1}" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-${pi/2.0}" upper="${pi/2.0}" effort="25" velocity="1.5"/></joint>
  <link name="arm_link_3"><visual><origin xyz="${arm_link3/2.0} 0 0"/><geometry><box size="${arm_link3} 0.045 0.045"/></geometry><material name="Yellow"><color rgba="0.9 0.8 0.2 1.0"/></material></visual></link>
  <joint name="arm_joint_3" type="revolute"><parent link="arm_link_2"/><child link="arm_link_3"/><origin xyz="${arm_link2} 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-${pi/2.0}" upper="${pi/2.0}" effort="20" velocity="1.5"/></joint>
  <link name="arm_link_4"><visual><origin xyz="${arm_link3} 0 0"/><geometry><box size="${arm_link3} 0.035 0.035"/></geometry><material name="Purple"><color rgba="0.7 0.2 0.8 1.0"/></material></visual></link>
  <joint name="arm_joint_4" type="revolute"><parent link="arm_link_3"/><child link="arm_link_4"/><origin xyz="${arm_link3} 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-${pi}" upper="${pi}" effort="15" velocity="2.0"/></joint>
  <link name="gripper_link"><visual><geometry><box size="0.06 0.02 0.02"/></geometry><material name="Black"><color rgba="0.1 0.1 0.1 1.0"/></material></visual></link>
  <joint name="gripper_joint" type="fixed"><parent link="arm_link_4"/><child link="gripper_link"/><origin xyz="${arm_link3} 0 0" rpy="0 0 0"/></joint>
  <link name="left_finger_link"><visual><origin xyz="0.02 0.015 0"/><geometry><box size="0.04 0.01 0.02"/></geometry><material name="Silver"><color rgba="0.85 0.85 0.85 1.0"/></material></visual></link>
  <joint name="left_finger_joint" type="prismatic"><parent link="gripper_link"/><child link="left_finger_link"/><origin xyz="0.03 0.012 0" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="0.0" upper="0.03" effort="10" velocity="0.5"/></joint>
  <link name="right_finger_link"><visual><origin xyz="0.02 -0.015 0"/><geometry><box size="0.04 0.01 0.02"/></geometry><material name="Silver"/></visual></link>
  <joint name="right_finger_joint" type="prismatic"><parent link="gripper_link"/><child link="right_finger_link"/><origin xyz="0.03 -0.012 0" rpy="0 0 0"/><axis xyz="0 -1 0"/><limit lower="0.0" upper="0.03" effort="10" velocity="0.5"/></joint>
  <link name="wheel_front_left_link"><visual><geometry><cylinder length="0.03" radius="0.05"/></geometry></visual></link>
  <joint name="wheel_front_left_joint" type="continuous"><parent link="base_link"/><child link="wheel_front_left_link"/><origin xyz="0.16 0.12 0.03" rpy="1.5708 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="wheel_front_right_link"><visual><geometry><cylinder length="0.03" radius="0.05"/></geometry></visual></link>
  <joint name="wheel_front_right_joint" type="continuous"><parent link="base_link"/><child link="wheel_front_right_link"/><origin xyz="0.16 -0.12 0.03" rpy="1.5708 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="wheel_rear_left_link"><visual><geometry><cylinder length="0.03" radius="0.05"/></geometry></visual></link>
  <joint name="wheel_rear_left_joint" type="continuous"><parent link="base_link"/><child link="wheel_rear_left_link"/><origin xyz="-0.16 0.12 0.03" rpy="1.5708 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="wheel_rear_right_link"><visual><geometry><cylinder length="0.03" radius="0.05"/></geometry></visual></link>
  <joint name="wheel_rear_right_joint" type="continuous"><parent link="base_link"/><child link="wheel_rear_right_link"/><origin xyz="-0.16 -0.12 0.03" rpy="1.5708 0 0"/><axis xyz="0 1 0"/></joint>
</robot>
